digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=0.9, pad=0.3];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  carts [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>carts</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>user_id (unique)<br align="left"/>created_at, updated_at<br align="left"/></td></tr></table>>];
  cart_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>cart_items</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>cart_id (FK)<br align="left"/>product_id<br align="left"/>quantity (&gt; 0)<br align="left"/></td></tr></table>>];
  orders [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#C55A11"><font color="white"><b>orders</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>user_id<br align="left"/>status<br align="left"/>total<br align="left"/>shipping_address<br align="left"/>payment_method<br align="left"/>created_at, updated_at<br align="left"/></td></tr></table>>];
  order_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#C55A11"><font color="white"><b>order_items</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>order_id (FK)<br align="left"/>product_id, product_name<br align="left"/>unit_price, quantity<br align="left"/></td></tr></table>>];
  history [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#C55A11"><font color="white"><b>order_status_history</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>order_id (FK)<br align="left"/>from_status, to_status<br align="left"/>changed_by, changed_at<br align="left"/></td></tr></table>>];
  invoices [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#548235"><font color="white"><b>invoices</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>order_id (FK, unique)<br align="left"/>number (unique)<br align="left"/>total, issued_at<br align="left"/></td></tr></table>>];
  deliveries [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#548235"><font color="white"><b>deliveries</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>order_id (FK, unique)<br align="left"/>status<br align="left"/>shipped_at, delivered_at<br align="left"/>updated_by<br align="left"/></td></tr></table>>];
  refunds [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#548235"><font color="white"><b>refunds</b></font></td></tr>
    <tr><td align="left">id (PK)<br align="left"/>order_id (FK, unique)<br align="left"/>amount, reason<br align="left"/>created_by, created_at<br align="left"/></td></tr></table>>];

  carts -> cart_items [label="1 — 0..*", arrowhead=crow];
  orders -> order_items [label="1 — 1..*", arrowhead=crow];
  orders -> history [label="1 — 1..*", arrowhead=crow];
  orders -> invoices [label="1 — 0..1", arrowhead=none];
  orders -> deliveries [label="1 — 0..1", arrowhead=none];
  orders -> refunds [label="1 — 0..1", arrowhead=none];
}
