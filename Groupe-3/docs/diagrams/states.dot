digraph States {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=0.7, pad=0.3];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#DEEAF6", color="#1F3864"];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];
  start [shape=circle, label="", width=0.2, fillcolor="#1F3864", style=filled];
  CANCELLED [fillcolor="#F8CBAD", color="#C55A11"];
  REFUNDED  [fillcolor="#F8CBAD", color="#C55A11"];
  DELIVERED [fillcolor="#C6E0B4", color="#548235"];

  start -> PENDING [label="valider la commande\n(client)"];
  PENDING -> CONFIRMED [label="paiement accepté\n+ facture"];
  CONFIRMED -> PREPARING [label="admin"];
  PREPARING -> SHIPPED [label="admin / livreur"];
  SHIPPED -> DELIVERED [label="livreur"];
  PENDING -> CANCELLED [label="annuler"];
  CONFIRMED -> CANCELLED [label="annuler"];
  PREPARING -> CANCELLED [label="annuler"];
  CONFIRMED -> REFUNDED [label="rembourser\n(admin)"];
  DELIVERED -> REFUNDED [label="rembourser\n(admin)"];
}
