digraph Classes {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.45, ranksep=0.7, pad=0.3];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];

  routes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>Routes (Express)</b></font></td></tr>
   <tr><td align="left">/api/cart, /api/orders<br align="left"/>validation des entrées<br align="left"/>codes HTTP<br align="left"/></td></tr></table>>];
  auth [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7F7F7F"><font color="white"><b>Middleware Auth</b></font></td></tr>
   <tr><td align="left">+ authenticate(secret)<br align="left"/>+ requireRole(...roles)<br align="left"/></td></tr></table>>];
  cs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>CartService</b></font></td></tr>
   <tr><td align="left">+ getCart(userId)<br align="left"/>+ addItem(userId, productId, qty)<br align="left"/>+ setQuantity(...)<br align="left"/>+ removeItem(...)<br align="left"/>+ clear(userId)<br align="left"/>+ rawItems(userId)<br align="left"/></td></tr></table>>];
  os [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#C55A11"><font color="white"><b>OrderService</b></font></td></tr>
   <tr><td align="left">+ createOrder(user, data)<br align="left"/>+ listOrders(user, filtre)<br align="left"/>+ getOrderFor(user, id)<br align="left"/>+ confirm / cancel / prepare<br align="left"/>+ ship / deliver / refund<br align="left"/>+ getInvoice(user, id)<br align="left"/>+ getDelivery(user, id)<br align="left"/>+ getHistory(user, id)<br align="left"/></td></tr></table>>];
  st [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#548235"><font color="white"><b>OrderStatus</b></font></td></tr>
   <tr><td align="left">STATUS (7 états)<br align="left"/>TRANSITIONS<br align="left"/>ROLES_FOR_TARGET<br align="left"/>+ canTransition(from, to)<br align="left"/></td></tr></table>>];
  cat [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7F7F7F"><font color="white"><b>«interface» CatalogClient (Groupe 2)</b></font></td></tr>
   <tr><td align="left">+ getProduct(productId)<br align="left"/>+ reserveStock(lines)<br align="left"/>+ releaseStock(lines)<br align="left"/></td></tr></table>>];
  mem [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#BF9000"><font color="white"><b>InMemoryCatalog</b></font></td></tr>
   <tr><td align="left">(version de test et de démonstration)<br align="left"/></td></tr></table>>];
  db [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7F7F7F"><font color="white"><b>Base SQLite</b></font></td></tr>
   <tr><td align="left">carts, cart_items, orders,<br align="left"/>order_items, order_status_history,<br align="left"/>invoices, deliveries, refunds<br align="left"/></td></tr></table>>];
  err [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7F7F7F"><font color="white"><b>AppError</b></font></td></tr>
   <tr><td align="left">status, code, message<br align="left"/></td></tr></table>>];

  routes -> auth [label="utilise"];
  routes -> cs [label="appelle"];
  routes -> os [label="appelle"];
  os -> cs [label="lit le panier"];
  os -> st [label="règles d'état"];
  cs -> cat [label="produits, prix, stock"];
  os -> cat [label="réserve / libère"];
  mem -> cat [arrowhead=empty, style=dashed, label="implémente"];
  cs -> db;
  os -> db;
  os -> err [style=dotted, label="lève"];
}
